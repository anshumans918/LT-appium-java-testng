<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite thread-count="100" name="Mobile" parallel="tests">

    <test name="iOS 16">
        <parameter name="version" value="16"/>
        <parameter name="platform" value="iOS"/>
        <parameter name="device" value="iPhone.*"/>
        <classes>
            <class name="iOSApp"/>
        </classes>
    </test>

    <test name="iOS 26">
        <parameter name="version" value="26"/>
        <parameter name="platform" value="iOS"/>
        <parameter name="device" value="iPhone.*"/>
        <classes>
            <class name="iOSApp"/>
        </classes>
    </test>

    <test name="iOS 27">
        <parameter name="version" value="27"/>
        <parameter name="platform" value="iOS"/>
        <parameter name="device" value="iPhone.*"/>
        <classes>
            <class name="iOSApp"/>
        </classes>
    </test>

    <test name="iPadOS 26">
        <parameter name="version" value="26"/>
        <parameter name="platform" value="iOS"/>
        <parameter name="device" value="iPad.*"/>
        <classes>
            <class name="iOSApp"/>
        </classes>
    </test>

</suite>